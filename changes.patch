+/// The duration row's title and footer: an offer goes to one owner; Buy Orders (concept): an order waits for anyone
+/// who owns a gift of the collection.
+private func giftDurationTexts(mode: StarsWithdrawScreen.Mode, currency: CurrencyAmount.Currency, duration: Int32, strings: PresentationStrings) -> (title: String, footer: String)? {
+    switch mode {
+    case let .starGiftOffer(peer, _, _):
+        let peerName = peer.compactDisplayTitle
+        switch currency {
+        case .stars:
+            return (strings.Gift_Offer_Duration, strings.Gift_Offer_DurationDescriptionStars(peerName).string)
+        case .ton:
+            return (strings.Gift_Offer_Duration, strings.Gift_Offer_DurationDescriptionTon(peerName).string)
+        }
+    case .starGiftBuyOrder:
+        let hours = duration / 3600
+        switch currency {
+        case .stars:
+            return ("Order Duration", "Your Stars are held while the order is open and return to you if nobody sells within \(hours) hours.")
+        case .ton:
+            return ("Order Duration", "Your GRAM is held while the order is open and returns to you if nobody sells within \(hours) hours.")
+        }
+    default:
+        return nil
+    }
+}
